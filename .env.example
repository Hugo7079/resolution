# ── LLM（分類 / 七軸拆解 / 標題在地化）──
# d8ai gateway（litellm proxy，OpenAI 相容）。金鑰向內部索取。
RES_LLM_API_KEY=
RES_LLM_BASE_URL=https://llm-gateway.d8ai.ai/
RES_LLM_MODEL=gemma-4-31B-it
RES_LLM_RPM=45

# ── 讀圖（第一段：客觀視覺描述）──
# Cloudflare Workers AI。免費額度 10,000 neurons/天，與「晨誌」共用同一個帳號，
# 所以這裡自我節制在 RES_CF_NEURON_BUDGET。
RES_CF_ACCOUNT_ID=
RES_CF_API_TOKEN=
RES_CF_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
RES_CF_NEURON_BUDGET=1200

# 絕不使用生圖模型 —— 對設計媒體來說生成封面是自傷（見 README 六）
